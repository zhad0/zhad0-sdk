{
  "name": "@zhad0/sdk",
  "version": "0.1.2",
  "description": "ZHAD0 Protocol SDK — ZK privacy layer for AI agents on Base",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./langchain": {
      "import": "./dist/adapters/langchain.mjs",
      "require": "./dist/adapters/langchain.cjs"
    },
    "./vercel-ai": {
      "import": "./dist/adapters/vercel-ai.mjs",
      "require": "./dist/adapters/vercel-ai.cjs"
    },
    "./agentkit": {
      "import": "./dist/adapters/agentkit.mjs",
      "require": "./dist/adapters/agentkit.cjs"
    },
    "./eliza": {
      "import": "./dist/adapters/eliza.mjs",
      "require": "./dist/adapters/eliza.cjs"
    },
    "./virtuals": {
      "import": "./dist/adapters/virtuals.mjs",
      "require": "./dist/adapters/virtuals.cjs"
    },
    "./autogen": {
      "import": "./dist/adapters/autogen.mjs",
      "require": "./dist/adapters/autogen.cjs"
    },
    "./crewai": {
      "import": "./dist/adapters/crewai.mjs",
      "require": "./dist/adapters/crewai.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhad0/zhad0-sdk.git"
  },
  "homepage": "https://zhad0.io",
  "bugs": {
    "url": "https://github.com/zhad0/zhad0-sdk/issues"
  },
  "keywords": [
    "zhad0",
    "zk",
    "privacy",
    "base",
    "sdk",
    "schnorr",
    "secp256k1",
    "ai-agent",
    "ghost-relay",
    "langchain",
    "agentkit",
    "eliza"
  ]
}
